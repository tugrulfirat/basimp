# Preview via IP: http://89.167.35.53:8080
server {
    listen 8080;
    server_name _;

    root /var/www/basimp;
    index app.html;

    location / {
        try_files $uri $uri.html $uri/ /app.html;
    }
}

# Final Production: http://bimp.us
server {
    listen 80;
    server_name bimp.us www.bimp.us;

    root /var/www/basimp;
    index app.html;

    location / {
        try_files $uri $uri.html $uri/ /app.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Proxy for the bimp-api backend (auth, credits, Stripe webhooks)
    location /api/ {
        proxy_pass http://localhost:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_cache_bypass $http_upgrade;
    }

    error_page 404 /app.html;
}

