[Unit]
Description=rapidlander.com backend app
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/rapidlander
Environment=NODE_ENV=production
EnvironmentFile=-/etc/rapidlander.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
